{% extends '@AmzsCore/base.html.twig' %}

{% block title %}
    CMS - Gallery Management
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link
            rel="stylesheet"
            href="{{ asset(get_path_gallery_cms_asset() ~ 'assets/css/gallery.css') }}"
            data-turbo-track="reload"
    >
{% endblock %}

{% block toolbar %}
    {% embed '@AmzsCore/Layout/_toolbar.html.twig' %}
        {% block toolbar_title %}
            Gallery Management
        {% endblock %}

        {% block toolbar_breadcrumbs %}
            <li class="breadcrumb-item text-muted">
                <a href="#" class="text-muted text-hover-primary">
                    Gallery
                </a>
            </li>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    {# nút gọi modal #}
    <div class="card-toolbar">

        <a
                href="javascript:void(0)"
                class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
                data-amzs-gallery-modal
                data-bs-toggle="tooltip"
                title="Open Gallery"
        >
            <i class="ki-duotone ki-pencil fs-7">
                <span class="path1"></span>
                <span class="path2"></span>
            </i>
        </a>

    </div>
    <div id="gallerySPA">
        {% include '@AmzsGallery/gallery/_content.html.twig' %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script
            type="module"
            src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@latest/dist/turbo.es2017-esm.min.js"
            data-turbo-track="reload">
    </script>

    {# phải tắt js một trong 2 tránh bị gọi trên cùng 1 trang gây lỗi cho modal #}
{#    <script#}
{#            src="{{ asset(get_path_gallery_cms_asset() ~ 'assets/js/gallery.js') }}"#}
{#            data-turbo-track="reload">#}
{#    </script>#}
    <script
            src="{{ asset(get_path_gallery_cms_asset() ~ 'assets/js/gallery_modal.js') }}"
            data-turbo-track="reload">
    </script>
{% endblock %}