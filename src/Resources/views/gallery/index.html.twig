{% extends '@AmzsCore/base.html.twig' %}

{% block title %}CMS - Gallery Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset(get_path_gallery_cms_asset() ~ 'assets/css/gallery.css') }}">
{% endblock %}

{% block toolbar %}
    {% embed '@AmzsCore/Layout/_toolbar.html.twig' %}
        {% block toolbar_title %}
            Gallery Management
        {% endblock %}

        {% block toolbar_breadcrumbs %}
            <li class="breadcrumb-item text-muted">
                <a href="#" class="text-muted text-hover-primary">Gallery</a>
            </li>
        {% endblock %}

        {% block toolbar_button_actions %}

        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    {# Bọc toàn bộ vùng quản lý tệp tin vào Turbo Frame #}
    <turbo-frame id="media_library_spa" data-current-folder="{{ currentFolderId }}">
        <div class="media-manager-wrapper card shadow-sm">

            {# 1. THANH BREADCRUMBS ĐỘNG #}
            <div class="manager-toolbar d-flex flex-wrap align-items-center justify-content-between p-6 border-bottom">
                <div class="breadcrumbs" id="breadcrumbsContainer">
                    {% for crumb in breadcrumbs %}
                        {% if loop.last %}
                            <span class="crumb active">
                                {% if loop.first %}<i class="ti ti-home"></i> {% endif %}{{ crumb.name }}
                            </span>
                        {% else %}
                            <a href="{{ path('amzs_admin_gallery_index_route', { folderId: crumb.id }) }}" class="crumb text-hover-primary text-dark">
                                {% if loop.first %}<i class="ti ti-home"></i> {% endif %}{{ crumb.name }}
                            </a>
                            <span class="crumb-separator"><i class="ti ti-chevron-right"></i></span>
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="toolbar-actions d-flex gap-2">
                    <button class="btn btn-sm btn-light-primary" id="btnCreateFolder"><i class="ti ti-folder-plus fs-5"></i> Tạo thư mục mới</button>
                    <button class="btn btn-sm btn-dark" id="btnUploadImg"><i class="ti ti-cloud-upload fs-5"></i> Tải ảnh lên</button>
                </div>
            </div>

            {# 2. LƯỚI DANH SÁCH FILE & FOLDER #}
            <div class="manager-body p-6 bg-light-opacity">
                <div class="gallery-grid" id="galleryGrid">

                    {# Nút quay lại (..) nếu đang ở thư mục con #}
                    {% if currentFolderId > 0 %}
                        {# ID của thư mục cha là ID của phần tử kế cuối trong mảng breadcrumbs #}
                        {% set parentFolderId = breadcrumbs[breadcrumbs|length - 2].id|default(0) %}
                        <a href="{{ path('amzs_admin_gallery_index_route', { folderId: parentFolderId }) }}" class="col-folder text-decoration-none">
                            <div class="folder-item-card root-card">
                                <i class="ti ti-arrow-back-up"></i>
                                <div class="folder-card-name">.. (Quay lại)</div>
                            </div>
                        </a>
                    {% endif %}

                    {# Render danh sách Thư mục con #}
                    {% for folder in folders %}
                        <a href="{{ path('amzs_admin_gallery_index_route', { folderId: folder.id }) }}" class="col-folder text-decoration-none text-dark">
                            <div class="folder-item-card">
                                <i class="ti ti-folder-filled"></i>
                                <div class="folder-card-name">{{ folder.name }}</div>
                            </div>
                        </a>
                    {% endfor %}

                    {# Render danh sách Hình ảnh #}
                    {% for img in pictures %}
                        <div class="col-img" data-id="{{ img.id }}">
                            <div class="gallery-item">
                                <div class="select-badge"><i class="ti ti-check" style="font-size:12px"></i></div>
                                <img src="{{ asset(img.url) }}" alt="{{ img.name }}" loading="lazy">
                                <div class="img-name">{{ img.name }}</div>
                            </div>
                        </div>
                    {% endfor %}

                    {% if folders is empty and pictures is empty %}
                        <div class="w-100 text-center p-10 text-muted">Thư mục này trống rỗng.</div>
                    {% endif %}

                </div>
            </div>

            {# 3. THANH FOOTER TRẠNG THÁI #}
            <div class="manager-foot d-flex align-items-center justify-content-between p-6 border-top bg-white">
                <span class="count-badge" id="selectedCount">Đã chọn: 0 ảnh</span>
                <div class="foot-actions d-flex gap-2">
                    <button class="btn btn-secondary btn-sm" id="btnDeselectAll" disabled><i class="ti ti-x"></i> Bỏ chọn tất cả</button>
                    <button class="btn btn-light-danger btn-sm" id="btnDeleteSelected" disabled><i class="ti ti-trash"></i> Xóa ảnh đã chọn</button>
                    <button class="btn btn-primary btn-sm" id="btnConfirmSelect" disabled><i class="ti ti-check"></i> Áp dụng ảnh đã chọn (<span class="count">0</span>)</button>
                </div>
            </div>

        </div>
    </turbo-frame>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@latest/dist/turbo.es2017-esm.min.js"></script>
    <script src="{{ asset(get_path_gallery_cms_asset() ~ 'assets/js/gallery2.js') }}"></script>
{% endblock %}