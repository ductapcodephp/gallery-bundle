{% extends '@AmzsCore/base.html.twig' %}

{% block title %}
    CMS - Gallery Management
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link
            rel="stylesheet"
            href="{{ asset(get_path_gallery_cms_asset() ~ 'assets/css/gallery.css') }}"
            data-turbo-track="reload"
    >
{% endblock %}

{% block toolbar %}
    {% embed '@AmzsCore/Layout/_toolbar.html.twig' %}
        {% block toolbar_title %}
            Gallery Management
        {% endblock %}

        {% block toolbar_breadcrumbs %}
            <li class="breadcrumb-item text-muted">
                <a href="#" class="text-muted text-hover-primary">
                    Gallery
                </a>
            </li>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <div id="gallerySPA">
        {% include '@AmzsGallery/gallery/_content.html.twig' %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script
            type="module"
            src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@latest/dist/turbo.es2017-esm.min.js"
            data-turbo-track="reload">
    </script>


    <script
            src="{{ asset(get_path_gallery_cms_asset() ~ 'assets/js/gallery2.js') }}"
            data-turbo-track="reload">
    </script>
{% endblock %}