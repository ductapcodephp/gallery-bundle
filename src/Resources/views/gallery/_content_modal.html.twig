
<div id="gallery-modal-wrapper">

    <div class="amzs-sidebar">
        <p class="amzs-sidebar-title">THƯ MỤC</p>

        <ul class="amzs-folder-list">
            <li>
                <a href="{{ path('amzs_admin_gallery_modal_route', {folderId: 0}) }}"
                   class="amzs-folder-item {{ currentFolderId == 0 ? 'active' : '' }}"
                   data-turbo-frame="gallery_main_content">
                    <span><i class="bi bi-images me-2"></i>Tất cả ảnh</span>
                </a>
            </li>
            {% include '@AmzsGallery/gallery/_folder_tree.html.twig' with {
                folders: sidebarFolders,
                currentFolderId: currentFolderId
            } %}
        </ul>
    </div>

    <div class="amzs-main">
        {% include '@AmzsGallery/gallery/_main_content.html.twig' %}
    </div>

</div>

<div class="amzs-footer">
    <div class="amzs-footer-left">
        <span class="text-muted small" id="modal-selectedCount">Chưa chọn ảnh nào</span>

        <nav aria-label="Page navigation" id="amzs-pagination-wrapper">
        </nav>
    </div>

    <div class="amzs-footer-right">
        <button class="btn btn-outline-secondary btn-sm px-3" id="modal-btnDeselectAll" disabled>Bỏ chọn</button>
        <button class="btn btn-warning btn-sm px-3 d-none" id="modal-btnEditSelected">Sửa</button>
        <button class="btn btn-danger btn-sm px-3" id="modal-btnDeleteSelected" disabled>Xóa</button>
        <button class="btn btn-outline-secondary btn-sm px-3" id="modal-btnUploadImg">Tải lên</button>
        <button class="btn btn-outline-secondary btn-sm px-3" id="modal-btnAddFolder">
            <i class="bi bi-folder-plus me-1"></i>Thư mục
        </button>
        <button class="btn btn-primary btn-sm px-4" id="modal-btnConfirmSelect" disabled>
            Chèn ảnh (<span class="count">0</span>)
        </button>
    </div>
</div>