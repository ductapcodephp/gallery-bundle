<turbo-frame id="media_library_spa" data-current-folder="{{ currentFolderId }}">

    {% if sidebarFolders is defined %}
        <turbo-stream action="update" target="gallery-sidebar-tree-wrapper">
            <template>
                {% include '@AmzsGallery/gallery/_folder_tree_index.html.twig' with {
                    folders: sidebarFolders,
                    currentFolderId: currentFolderId
                } %}
            </template>
        </turbo-stream>
    {% endif %}

    <div class="manager-toolbar p-5 border-bottom bg-white d-flex align-items-center justify-content-between flex-wrap gap-4">

        <div class="amzs-breadcrumb d-flex align-items-center gap-1">
            {% for crumb in breadcrumbs %}
                {% if loop.last %}
                    <span class="crumb active fw-bold text-dark">
                        {% if loop.first %}<i class="ti ti-home me-1"></i>{% endif %}
                        {{ crumb.name }}
                    </span>
                {% else %}
                    <a href="{{ path('amzs_admin_gallery_index_route', { folderId: crumb.id }) }}"
                       data-turbo-prefetch="false"
                       data-turbo-action="advance"
                       class="crumb text-muted text-hover-primary">
                        {% if loop.first %}<i class="ti ti-home me-1"></i>{% endif %}
                        {{ crumb.name }}
                    </a>
                    <span class="crumb-separator text-muted px-1"><i class="ti ti-chevron-right" style="font-size: 0.75rem;"></i></span>
                {% endif %}
            {% endfor %}
        </div>

        <div class="toolbar-actions d-flex gap-2">
            {% if currentFolderId > 0 %}
                {% set parentFolderId = breadcrumbs[breadcrumbs|length - 2].id|default(0) %}
                <a href="{{ path('amzs_admin_gallery_index_route', { folderId: parentFolderId }) }}"
                   data-turbo-action="advance"
                   data-turbo-prefetch="false"
                   class="btn btn-sm btn-light d-flex align-items-center gap-1">
                    <i class="ti ti-arrow-left"></i> Quay lại
                </a>
            {% endif %}

            <button type="button" id="btnAddFolder" class="btn btn-sm btn-outline-primary">
                <i class="ti ti-folder-plus me-1"></i> Thêm thư mục
            </button>

            <button class="btn btn-sm btn-primary" id="btnUploadImg">
                <i class="ti ti-cloud-upload me-1"></i> Tải ảnh lên
            </button>
        </div>
    </div>

    <div class="manager-body p-6">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4" id="galleryGrid">


            {% for img in pictures %}
                <div class="col" data-type="picture" data-id="{{ img.id }}">
                    <div class="gallery-item selectable-item position-relative border rounded p-2 text-center h-100 bg-hover-light cursor-pointer transition-3s"
                         data-type="picture"
                         data-id="{{ img.id }}">

                        <div class="select-badge position-absolute top-0 end-0 m-2 d-none">
                            <span class="badge bg-primary p-1"><i class="ti ti-check text-white"></i></span>
                        </div>

                        <div class="img-ratio-box overflow-hidden rounded mb-2 d-flex align-items-center justify-content-center bg-light" style="height: 120px;">
                            <img src="{{ asset(img.image) }}"
                                 alt="{{ img.name }}"
                                 loading="lazy"
                                 class="img-fluid max-h-100 obj-fit-contain" />
                        </div>

                        <div class="img-name text-muted small text-truncate px-1" title="{{ img.name }}">
                            {{ img.name }}
                        </div>
                    </div>
                </div>
            {% endfor %}

            {% if folders is empty and pictures is empty %}
                <div class="col-100 w-100 text-center py-10 text-muted my-10">
                    <div class="mb-3"><i class="ti ti-image-off fs-1 text-muted"></i></div>
                    Thư mục này trống rỗng.
                </div>
            {% endif %}

        </div>

        <div class="navigation">
            {{ knp_pagination_render(pictures) }}
        </div>

    </div>
    <input type="file" multiple accept="image/*" id="spaHiddenFileInput" style="display: none;" />
</turbo-frame>