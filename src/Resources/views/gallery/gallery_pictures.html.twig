{% extends '@AmzsCore/base.html.twig' %}

{% block title %}CMS - Gallery Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset(get_path_gallery_cms_asset() ~ 'assets/css/gallery.css') }}">
{% endblock %}

{% block toolbar %}
    {% embed '@AmzsCore/Layout/_toolbar.html.twig' %}
        {% block toolbar_title %}
            Gallery Management
        {% endblock %}

        {% block toolbar_breadcrumbs %}
            <li class="breadcrumb-item text-muted">
                <a href="#" class="text-muted text-hover-primary">Gallery</a>
            </li>
        {% endblock %}

        {% block toolbar_button_actions %}

        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <div class="media-manager-wrapper card shadow-sm">

        {# Thanh công cụ thao tác & Breadcrumbs SPA #}
        <div class="manager-toolbar d-flex flex-wrap align-items-center justify-content-between p-6 border-bottom">
            <div class="breadcrumbs" id="breadcrumbsContainer">
                {# Ban đầu mặc định ở gốc #}
                <span class="crumb active" data-target-folder="0"><i class="ti ti-home"></i> Thư mục gốc</span>
            </div>

            <div class="toolbar-actions d-flex gap-2">
                <button class="btn btn-sm btn-light-primary" id="btnCreateFolder">
                    <i class="ti ti-folder-plus fs-5"></i> Tạo thư mục mới
                </button>
                <button class="btn btn-sm btn-dark" id="btnUploadImg">
                    <i class="ti ti-cloud-upload fs-5"></i> Tải ảnh lên
                </button>
            </div>
        </div>

        {# Khu vực chứa lưới thư mục & hình ảnh (SPA gán nội dung vào đây) #}
        <div class="manager-body p-6 bg-light-opacity">
            {# Thêm thuộc tính data-current-folder` để JS nhận diện trạng thái vị trí #}
            <div class="gallery-grid" id="galleryGrid" data-current-folder="0">

                {# Đổ danh sách thư mục gốc từ biến hệ thống có sẵn của bạn #}
                {% for gallery in galleries|default([]) %}
                    <div class="col-folder" data-folder-id="{{ gallery.id }}">
                        <div class="folder-item-card">
                            <i class="ti ti-folder-filled"></i>
                            <div class="folder-card-name">{{ gallery.name }}</div>
                        </div>
                    </div>
                {% else %}
                    {# Nếu chưa có dữ liệu, JS sẽ tự động handle hoặc hiển thị trống #}
                    <div class="w-100 text-center p-10 text-muted" id="emptyNotify">
                        Chưa có thư mục nào được tạo. Hãy nhấn "Tạo thư mục mới"!
                    </div>
                {% endfor %}

            </div>
        </div>

        <div class="manager-foot d-flex align-items-center justify-content-between p-6 border-top bg-white">
            <span class="count-badge" id="selectedCount">Đã chọn: 0 ảnh</span>
            <div class="foot-actions d-flex gap-2">
                <button class="btn btn-secondary btn-sm" id="btnDeselectAll" disabled><i class="ti ti-x"></i> Bỏ chọn tất cả</button>
                <button class="btn btn-light-danger btn-sm" id="btnDeleteSelected" disabled><i class="ti ti-trash"></i> Xóa ảnh đã chọn</button>
                <button class="btn btn-primary btn-sm" id="btnConfirmSelect" disabled><i class="ti ti-check"></i> Áp dụng ảnh đã chọn (<span class="count">0</span>)</button>
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset(get_path_gallery_cms_asset() ~ 'assets/js/gallery.js') }}"></script>
{% endblock %}