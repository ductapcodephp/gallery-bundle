<ul class="amzs-nested list-unstyled ps-4 mt-1">
    {% for folder in folders %}
        <li class="mb-1">
            <a href="{{ path('amzs_admin_gallery_index_route', {folderId: folder.id}) }}"
               class="amzs-folder-item d-flex align-items-center p-2 rounded text-dark text-hover-primary {{ currentFolderId == folder.id ? 'bg-light-primary text-primary fw-bold' : '' }}"
               data-turbo-frame="media_library_spa"
               data-turbo-action="advance">

                <span class="d-flex align-items-center">
                    {% if currentFolderId == folder.id %}
                        <i class="ti ti-folder-open me-2 text-primary" style="font-size: 1.15rem;"></i>
                    {% else %}
                        <i class="ti ti-folder me-2 text-warning" style="font-size: 1.15rem;"></i>
                    {% endif %}

                    <span class="text-truncate" style="max-width: 180px;" title="{{ folder.name }}">
                        {{ folder.name }}
                    </span>
                </span>
            </a>

            {% if folder.children is defined and folder.children|length > 0 %}
                {% include '@AmzsGallery/gallery/_folder_tree_index.html.twig' with {
                    folders: folder.children,
                    currentFolderId: currentFolderId
                } %}
            {% endif %}
        </li>
    {% endfor %}
</ul>