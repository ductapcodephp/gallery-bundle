<div class="modal fade" id="modalEditPicture" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center">
                    <i class="ti ti-edit me-2 text-warning fs-5"></i>
                    Chỉnh sửa thông tin ảnh
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            {{ form_start(form) }}
            <div class="modal-body">

                <div class="text-center mb-4 p-3 bg-light rounded border">
                    <img src="{{ asset(galleryPicture.image) }}" alt="Preview" class="img-thumbnail" style="max-height: 120px; object-fit: contain;">
                    <div class="text-muted small mt-1">Đường dẫn gốc: {{ galleryPicture.image }}</div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.name) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.sortOrder, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.sortOrder) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.title) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.subTitle, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.subTitle) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            {{ form_label(form.link, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.link) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            {{ form_label(form.urlVideo, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.urlVideo) }}
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="submit" class="btn btn-warning px-4">
                    <i class="fas fa-save me-1"></i> Lưu thay đổi
                </button>
            </div>
            {{ form_end(form) }}

        </div>
    </div>
</div>